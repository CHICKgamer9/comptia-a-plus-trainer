# Preferred: Vercel AI Gateway (also works with Vercel OIDC on deployment)
AI_GATEWAY_API_KEY=

# Hosted auth (Clerk). Magic link + Google + Apple — enable those in the Clerk dashboard.
# No custom password database. Guest Start Here works without these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres (profiles + progress JSON). Required for signed-in sync.
DATABASE_URL=

# Optional. House plan seat_limit seed (1–6, default 6).
# HOUSE_SEAT_LIMIT=6


# Optional if you are not using the Gateway
# OPENAI_API_KEY=

# Optional neural TTS (Eleven Flash v2.5, else gpt-4o-mini-tts)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_NARRATOR=
# ELEVENLABS_VOICE_TARGET=

# Optional model override (provider/model slug)
# AI_MODEL=openai/gpt-5.4
